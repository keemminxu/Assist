// OpenClaw 설정 — Claude CLI를 런타임으로 강제
// 공식 문서: https://docs.openclaw.ai/providers/anthropic
{
  agents: {
    defaults: {
      // 1) 어떤 모델을 부를지 (provider/model 형식)
      model: {
        primary: "anthropic/claude-opus-4-7",
      },
      // 2) 그 모델을 어떻게 실행할지 (런타임 = Claude CLI)
      models: {
        "anthropic/claude-opus-4-7": {
          agentRuntime: { id: "claude-cli" },
        },
      },
    },
  },
}
