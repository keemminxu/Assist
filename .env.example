# 디스코드 봇 토큰 (Developer Portal → Bot → Reset Token 후 발급)
DISCORD_TOKEN=여기에_봇_토큰_붙여넣기

# OpenClaw 로컬 게이트웨이 (기본값 그대로 두면 됨)
OPENCLAW_BASE_URL=http://localhost:8000/v1
OPENCLAW_API_KEY=openclaw-local

# 사용할 Claude 모델 (Max 요금제: Opus 4.7 권장)
# 반드시 "anthropic/" 프리픽스 포함 — OpenClaw 공식 포맷
MODEL_NAME=anthropic/claude-opus-4-7
